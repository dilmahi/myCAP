<mvc:View xmlns:f="sap.f" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:tnt="sap.tnt" xmlns:mvc="sap.ui.core.mvc" controllerName="mbs.mybookshop220014ui.controller.DashBoard" displayBlock="true" height="100%">
				    
    <Page class="zEP_checklist">    
             



<GenericTile class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" header="Books"
		press="pressBooks" >
		<TileContent>
			<ImageContent src="sap-icon://course-book" />
		</TileContent>
	</GenericTile>

	<GenericTile class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" header="Favorites"
		press="pressFavs">
		<TileContent>
			<ImageContent src="sap-icon://favorite" />
		</TileContent>
	</GenericTile>

	<GenericTile class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" header="Recommended Books"
		 press="pressRecms">
		<TileContent>
			<ImageContent src="sap-icon://thumb-up" />
		</TileContent>
	</GenericTile>

    	<GenericTile class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout" header="KPIs"
		 press="pressKPIs">
		<TileContent>
			<ImageContent src="sap-icon://kpi-corporate-performance" />
		</TileContent>
	</GenericTile>

        
	</Page>
</mvc:View>